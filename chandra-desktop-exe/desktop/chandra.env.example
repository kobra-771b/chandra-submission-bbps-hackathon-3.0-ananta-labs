# Chandra Desktop's connection. Copy to chandra.env in Chandra's data folder:
#   Windows  %APPDATA%\Chandra\chandra.env
#   macOS    ~/Library/Application Support/Chandra/chandra.env
#   Linux    ~/.config/Chandra/chandra.env
# Chandra saves keys only to the file above. A chandra.env next to Chandra.exe / chandra.py is
# also read, and saving a key removes the copy there.
#
# This file is the ONLY place a key belongs. Chandra's page never contains one:
# it asks Chandra's host, and the host reads this file. The easy way to set it:
# Chandra > Settings > AI brain > paste the key > Save (Remove key clears it).

# Where the Chandra Engine (OpenJarvis's local server) listens.
CHANDRA_ENGINE_URL=http://127.0.0.1:8000

# Optional: a specific local model for the desktop. Empty = the engine's first model.
# CHANDRA_ENGINE_MODEL=qwen3.5:2b

# Optional: think with Claude (strongest). From console.anthropic.com; billed per use,
# separate from a Claude subscription. Set it in Settings > AI brain, or here.
# ANTHROPIC_API_KEY=

# Optional: Google Gemini, FREE (aistudio.google.com). With this and no Claude key, Chandra
# thinks with Gemini and reads the screen at no cost. It also powers recall by meaning and
# Chandra's natural voice. Set it in Settings > AI brain, or here.
# GEMINI_API_KEY=
# CHANDRA_GEMINI_MODEL=gemini-3.5-flash        (a retired name falls back to the next fast Flash model)
# CHANDRA_EMBED_MODEL=gemini-embedding-001     (recall by meaning)

# Chandra's natural voice (needs the Gemini key). Settings > Chandra voice picks the voice too.
# CHANDRA_TTS_VOICE=Sulafat                    (warm; others: Achernar soft, Vindemiatrix gentle, Aoede breezy, Kore firm, Charon informative, Puck upbeat)
# CHANDRA_TTS_MODEL=gemini-2.5-flash-preview-tts
# Listening (needs the Gemini key): the model that transcribes English, Hindi and Hinglish. Empty = a fast Flash model.
# CHANDRA_STT_MODEL=gemini-3.1-flash-lite

# Which brain: auto (Claude, then Gemini, then the local engine), claude, gemini, or engine.
# With no key at all, the Chandra Engine answers (text only; it cannot read the screen).
# CHANDRA_BRAIN=auto
